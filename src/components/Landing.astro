---
// The name over a black field of white Truchet lines drifting from the top left corner.
---

<main>
  <h1>Arnaud Jalbert</h1>
  <canvas aria-hidden="true"></canvas>
</main>

<style>
  main {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100vh;
    overflow: hidden;
  }

  h1 {
    margin: 0;
    padding: 0 1rem;
    font-size: clamp(3rem, 13vw, 12rem);
    font-weight: 800;
    line-height: 1;
    text-align: center;
    mix-blend-mode: difference;
  }

  canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // A grid of tiles slides diagonally. Each tile holds two thick quarter arcs joining edge
  // midpoints, in one of two orientations, so the arcs link into endless winding lines.
  // Every so often a random tile turns a quarter turn into its other orientation.
  const DRIFT_SPEED = 18; // px per second, along the diagonal
  const FLIP_INTERVAL = 0.12; // seconds between flips
  const FLIP_SECONDS = 0.9;
  const FRAME_MS = 1000 / 24;
  const GRAIN_TILE = 128;
  const GRAIN_STRENGTH = 24;

  type Tile = { orientation: number; flipStart: number }; // orientation 0 or 1

  const canvas = document.querySelector<HTMLCanvasElement>("main canvas")!;
  const context = canvas.getContext("2d")!;
  const tiles = new Map<string, Tile>();
  let size = 0;
  let width = 0;
  let height = 0;
  let offset = 0;
  let elapsed = 0;
  let sinceFlip = 0;

  const resize = () => {
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    canvas.width = width * devicePixelRatio;
    canvas.height = height * devicePixelRatio;
    context.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
    size = Math.round(Math.max(48, Math.min(width, height) / 9));
  };

  // Black and white with faint grain baked in, so grain costs nothing per frame.
  const createGrainFill = (color: string, direction: number) => {
    const tile = document.createElement("canvas");
    tile.width = tile.height = GRAIN_TILE;
    const tileContext = tile.getContext("2d")!;
    tileContext.fillStyle = color;
    tileContext.fillRect(0, 0, GRAIN_TILE, GRAIN_TILE);
    const pixels = tileContext.getImageData(0, 0, GRAIN_TILE, GRAIN_TILE);
    for (let i = 0; i < pixels.data.length; i += 4) {
      const shift = Math.random() * GRAIN_STRENGTH * direction;
      for (let channel = 0; channel < 3; channel++) pixels.data[i + channel] += shift;
    }
    tileContext.putImageData(pixels, 0, 0);
    return context.createPattern(tile, "repeat")!;
  };
  const black = createGrainFill("#000", 0.5);
  const white = createGrainFill("#fff", -1);

  const tileAt = (column: number, row: number) => {
    const key = `${column},${row}`;
    let tile = tiles.get(key);
    if (!tile) {
      tile = { orientation: Math.round(Math.random()), flipStart: -Infinity };
      tiles.set(key, tile);
    }
    return tile;
  };

  const ease = (t: number) => t * t * (3 - 2 * t);
  const flipProgress = (tile: Tile) => Math.min(1, (elapsed - tile.flipStart) / FLIP_SECONDS);

  // Arcs around the top left and bottom right corners. A quarter turn gives the other orientation.
  const addArcs = (path: Path2D, centerX: number, centerY: number, angle: number) => {
    const half = size / 2;
    const cos = Math.cos(angle);
    const sin = Math.sin(angle);
    const point = (x: number, y: number) => ({
      x: centerX + x * cos - y * sin,
      y: centerY + x * sin + y * cos,
    });
    for (const [cornerX, cornerY, start] of [
      [-half, -half, 0],
      [half, half, Math.PI],
    ]) {
      const corner = point(cornerX, cornerY);
      const from = point(cornerX + Math.cos(start) * half, cornerY + Math.sin(start) * half);
      path.moveTo(from.x, from.y);
      path.arc(corner.x, corner.y, half, start + angle, start + angle + Math.PI / 2);
    }
  };

  const strokeLines = (path: Path2D) => {
    context.strokeStyle = white;
    context.lineWidth = size / 3;
    context.stroke(path);
  };

  // Resting tiles are stroked as one path, so lines join across tile edges without seams.
  // Turning tiles are drawn on top, each clipped to its own square.
  const render = () => {
    context.fillStyle = black;
    context.fillRect(0, 0, width, height);
    const shift = offset % size;
    const first = -Math.floor(offset / size) - 1;
    const resting = new Path2D();
    const turning: { x: number; y: number; angle: number }[] = [];
    for (let row = 0; row * size - size < height + size; row++) {
      for (let column = 0; column * size - size < width + size; column++) {
        const centerX = column * size - size + shift + size / 2;
        const centerY = row * size - size + shift + size / 2;
        const tile = tileAt(first + column, first + row);
        const progress = flipProgress(tile);
        if (progress >= 1) {
          addArcs(resting, centerX, centerY, (tile.orientation * Math.PI) / 2);
        } else {
          const angle = ((tile.orientation - 1 + ease(progress)) * Math.PI) / 2;
          turning.push({ x: centerX, y: centerY, angle });
        }
      }
    }
    strokeLines(resting);
    for (const { x, y, angle } of turning) {
      context.save();
      context.beginPath();
      context.rect(x - size / 2, y - size / 2, size, size);
      context.clip();
      context.fillStyle = black;
      context.fillRect(x - size / 2, y - size / 2, size, size);
      const path = new Path2D();
      addArcs(path, x, y, angle);
      strokeLines(path);
      context.restore();
    }
  };

  const flipRandomTile = () => {
    const first = -Math.floor(offset / size) - 1;
    const column = first + Math.floor(Math.random() * (width / size + 2));
    const row = first + Math.floor(Math.random() * (height / size + 2));
    const tile = tileAt(column, row);
    if (flipProgress(tile) < 1) return;
    tile.orientation = 1 - tile.orientation;
    tile.flipStart = elapsed;
  };

  // Forget tiles that slid off the bottom right.
  const forgetHiddenTiles = () => {
    const first = -Math.floor(offset / size) - 1;
    for (const key of tiles.keys()) {
      const [column, row] = key.split(",").map(Number);
      if (column > first + width / size + 4 || row > first + height / size + 4) tiles.delete(key);
    }
  };

  const advance = (seconds: number) => {
    elapsed += seconds;
    offset += (DRIFT_SPEED / Math.SQRT2) * seconds;
    sinceFlip += seconds;
    while (sinceFlip > FLIP_INTERVAL) {
      sinceFlip -= FLIP_INTERVAL;
      flipRandomTile();
    }
    if (tiles.size > 4000) forgetHiddenTiles();
  };

  resize();
  render();
  addEventListener("resize", () => {
    resize();
    render();
  });

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let last = performance.now();
    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (now - last < FRAME_MS) return;
      advance(Math.min((now - last) / 1000, 0.1));
      last = now;
      render();
    };
    requestAnimationFrame(frame);
  }
</script>
