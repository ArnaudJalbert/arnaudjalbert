---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/inter";

interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const otherLang = lang === "en" ? "fr" : "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Arnaud Jalbert</title>
    <link rel="alternate" hreflang="en" href={new URL(getRelativeLocaleUrl("en"), Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(getRelativeLocaleUrl("fr"), Astro.site)} />
    <style is:global>
      body {
        margin: 0;
        background: #000;
        color: #fff;
        font-family: "Inter Variable", sans-serif;
      }
      .language-switch {
        position: fixed;
        top: 1.25rem;
        right: 1.5rem;
        z-index: 1;
        padding: 0.25rem 0.5rem;
        background: #000;
        color: inherit;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: "Bricolage Grotesque Variable", sans-serif;
      }
    </style>
  </head>
  <body>
    <slot />
    <a class="language-switch" href={getRelativeLocaleUrl(otherLang)} hreflang={otherLang} lang={otherLang}>
      {otherLang === "fr" ? "Français" : "English"}
    </a>
  </body>
</html>
